# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# MySQL Authentication Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nura_auth
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# MongoDB Profiles Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nura_profiles

# Redis Session Storage Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Security Settings
SESSION_TTL=3600
SESSION_COOKIE_NAME=nura_auth_session
CSRF_COOKIE_NAME=nura_csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
